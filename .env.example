# Copy the variables below into Netlify: Site configuration -> Environment variables.
# Do NOT commit a real .env file with actual credentials.

# SMTP connection details from your email provider
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
# "true" only if your provider uses implicit TLS on port 465; otherwise leave as false
SMTP_SECURE=false
SMTP_USER=admin@getaivy.info
SMTP_PASS=your-smtp-password-or-app-password

# Optional: defaults to SMTP_USER if not set
SMTP_FROM=admin@getaivy.info

# Optional: where the "new submission" notification goes. Defaults to andreasnot@getaivy.info
NOTIFY_EMAIL=andreasnot@getaivy.info
